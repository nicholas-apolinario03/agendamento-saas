generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id        Int    @id @default(autoincrement())
  nome      String
  email     String @unique
  senhaHash String
  telefone  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ativo        Boolean                @default(true)
  servicos     Servico[]
  horarios     HorarioFuncionamento[]
  agendamentos Agendamento[]
  assinatura Assinatura?

  sessoesWhatsApp SessaoWhatsApp[]
  integracaoWhatsApp IntegracaoWhatsApp?
  clientes Cliente[]
}

model Servico {
  id             Int     @id @default(autoincrement())
  empresaId      Int
  nome           String
  duracaoMinutos Int
  descricao      String?
  preco Decimal @db.Decimal(10,2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tipoDisponibilidade String @default("TODOS_OS_DIAS")

  ativo Boolean @default(true)

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  agendamentos Agendamento[]
    disponibilidadesSemanais DisponibilidadeSemanalServico[]

    excecoesDisponibilidade ExcecaoDisponibilidadeServico[]
}

model HorarioFuncionamento {
  id         Int     @id @default(autoincrement())
  empresaId  Int
  diaSemana  Int
  horaInicio String
  horaFim    String
  ativo      Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])
}

model Cliente {
  id        Int      @id @default(autoincrement())
  empresaId  Int
  nome      String
  email     String?
  telefone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, telefone])
  empresa Empresa @relation(fields: [empresaId], references: [id])
  agendamentos Agendamento[]
  
}

model Agendamento {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  servicoId      Int
  clienteId      Int?
  status         String   @default("AGENDADO")
  datahoraInicio DateTime
  datahoraFim    DateTime

    tokenConfirmacao         String?   @unique
  tokenConfirmacaoExpiraEm DateTime?
  confirmadoEm             DateTime?
  emailConfirmacaoEnviadoEm DateTime?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  servico Servico @relation(fields: [servicoId], references: [id])
  cliente Cliente? @relation(fields: [clienteId], references: [id])
}
model Assinatura {
  id Int @id @default(autoincrement())

  empresaId Int @unique

  plano String

  ativa Boolean @default(true)

  vencimento DateTime

  empresa Empresa @relation(fields: [empresaId], references: [id])
}
model SessaoWhatsApp {
    id               Int      @id @default(autoincrement())
    empresaId        Int
    telefone         String
    etapa            String

    servicoId        Int?
    dataEscolhida    DateTime?
    datahoraInicio   DateTime?

    atualizadoEm     DateTime @updatedAt
    criadoEm         DateTime @default(now())

    empresa Empresa  @relation(fields: [empresaId],references: [id],onDelete: Cascade)

    @@unique([empresaId, telefone])
}
model DisponibilidadeSemanalServico {
    id         Int     @id @default(autoincrement())
    servicoId  Int
    diaSemana  Int
    ativo      Boolean @default(true)

    servico Servico @relation( fields: [servicoId],references: [id], onDelete: Cascade )

    @@unique([servicoId, diaSemana])
}

model ExcecaoDisponibilidadeServico {
    id          Int      @id @default(autoincrement())
    servicoId   Int
    data        DateTime
    disponivel  Boolean

    servico Servico @relation( fields: [servicoId],references: [id],onDelete: Cascade )

    @@unique([servicoId, data])
}
model IntegracaoWhatsApp {
    id                       Int      @id @default(autoincrement())
    empresaId                Int      @unique
    wabaId                    String   @unique
    phoneNumberId             String   @unique
    numeroExibicao            String?
    nomeVerificado            String?
    accessTokenCriptografado  String
    conectado                 Boolean  @default(true)
    conectadoEm               DateTime @default(now())
    createdAt                 DateTime @default(now())
    updatedAt                 DateTime @updatedAt

    empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}